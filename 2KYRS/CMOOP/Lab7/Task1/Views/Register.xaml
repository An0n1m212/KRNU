<Window x:Class="Lab7.Task1.Views.Register"
    Background="{StaticResource BackgroundBrush}" 
    Height="620" Title="Реєстрація" Width="440" 
    WindowStartupLocation="CenterScreen"  
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="25">
            <StackPanel>
                <TextBlock Style="{StaticResource TitleStyle}" Text="Форма реєстрації"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,5,0">
                        <TextBlock Text="Ім'я:"/>
                        <TextBox Style="{StaticResource InputTextBoxStyle}" x:Name="txtFirstName"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="5,0,0,0">
                        <TextBlock Text="Прізвище:"/>
                        <TextBox Style="{StaticResource InputTextBoxStyle}" x:Name="txtLastName"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Логін (Username):"/>
                <TextBox Style="{StaticResource InputTextBoxStyle}" x:Name="txtUsername"/>

                <TextBlock Text="Email:"/>
                <TextBox Style="{StaticResource InputTextBoxStyle}" x:Name="txtEmail"/>

                <TextBlock Text="Пароль:"/>
                <PasswordBox Height="35" Margin="0,5,0,10" Padding="8,5" x:Name="txtPassword"/>

                <TextBlock Text="Підтвердження пароля:"/>
                <PasswordBox Height="35" Margin="0,5,0,10" Padding="8,5" x:Name="txtConfirmPassword"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,5,0">
                        <TextBlock Text="Вік:"/>
                        <TextBox Style="{StaticResource InputTextBoxStyle}" x:Name="txtAge"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="5,0,0,0">
                        <TextBlock Text="Стать:"/>
                        <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                            <RadioButton Content="Чолов." IsChecked="True" Margin="0,0,10,0" x:Name="rbMale"/>
                            <RadioButton Content="Жін." x:Name="rbFemale"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Адреса:"/>
                <TextBox Style="{StaticResource InputTextBoxStyle}" x:Name="txtAddress"/>

                <TextBlock Text="Поштовий індекс:"/>
                <TextBox Style="{StaticResource InputTextBoxStyle}" x:Name="txtZipCode"/>

                <TextBlock Text="Про себе:"/>
                <TextBox AcceptsReturn="True" Height="60" Margin="0,5,0,15" TextWrapping="Wrap" x:Name="txtAbout"/>

                <Button Click="Register_Click" Content="ЗАРЕЄСТРУВАТИСЯ" Style="{StaticResource MainButtonStyle}"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>