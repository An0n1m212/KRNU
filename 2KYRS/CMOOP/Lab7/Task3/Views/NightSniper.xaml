<Window x:Class="Lab7.Task3.Views.NightSniper" 
    Background="#121212" 
    Height="480" Title="Гра «Нічний Снайпер»" 
    Width="440" WindowStartupLocation="CenterScreen" 
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Foreground="White" Style="{StaticResource TitleStyle}" Text="Гра «Нічний Снайпер»"/>

        <!-- Игровое поле Снайпер -->
        <UniformGrid Columns="4" Grid.Row="1" Margin="10" Rows="4" x:Name="SniperGrid"/>

        <Button Click="Restart_Click" Content="Перезапустити грау" Grid.Row="2" HorizontalAlignment="Center" Style="{StaticResource MainButtonStyle}" Width="180"/>
    </Grid>
</Window>