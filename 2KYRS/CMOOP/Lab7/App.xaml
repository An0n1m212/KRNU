<Application x:Class="Lab7.App"
    StartupUri="MainWindow.xaml"  
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <!-- Цветовая палитра -->
        <SolidColorBrush Color="#60aceb" x:Key="PrimaryBrush"/>
        <SolidColorBrush Color="#4580b0" x:Key="DarkPrimaryBrush"/>
        <SolidColorBrush Color="#FF4081" x:Key="AccentBrush"/>
        <SolidColorBrush Color="#F5F5F5" x:Key="BackgroundBrush"/>
        <SolidColorBrush Color="#212121" x:Key="TextBrush"/>

        <!-- Стиль заголовков -->
        <Style TargetType="TextBlock" x:Key="TitleStyle">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>

        <!-- Стиль текстовых полей -->
        <Style TargetType="TextBox" x:Key="InputTextBoxStyle">
            <Setter Property="Height" Value="35"/>
            <Setter Property="Margin" Value="0,5,0,10"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Стандартная кнопка -->
        <Style TargetType="Button" x:Key="MainButtonStyle">
            <Setter Property="Background" Value="#60aceb"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Стиль кнопки «Фонарик» для игры Снайпер -->
        <ControlTemplate TargetType="Button" x:Key="FlashlightButtonTemplate">
            <Border Background="#1E1E24" BorderBrush="#333333" BorderThickness="2" CornerRadius="6" x:Name="border">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <!-- Подсветка фонариком при наведении -->
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" TargetName="border">
                        <Setter.Value>
                            <RadialGradientBrush Center="0.5,0.5" RadiusX="0.7" RadiusY="0.7">
                                <GradientStop Color="#FFFF9E" Offset="0"/>
                                <GradientStop Color="#332B00" Offset="0.6"/>
                                <GradientStop Color="#1E1E24" Offset="1"/>
                            </RadialGradientBrush>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Стиль Влучання (Попадание) -->
        <Style TargetType="Button" x:Key="HitButtonStyle">
            <Setter Property="Background" Value="#4CAF50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Content" Value="🎯"/>
        </Style>

        <!-- Стиль Промах -->
        <Style TargetType="Button" x:Key="MissButtonStyle">
            <Setter Property="Background" Value="#F44336"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Content" Value="❌"/>
        </Style>
    </Application.Resources>
</Application>