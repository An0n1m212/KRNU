<Window x:Class="Lab7.Task2.Views.Game2048"
    Background="#FAF8EF" 
    Height="520" KeyDown="Window_KeyDown" 
    Title="Гра 2048" Width="420" 
    WindowStartupLocation="CenterScreen"  
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Шапка счета -->
        <!-- Шапка з рахунком та кнопкою перезапуску -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="2048" FontSize="36" FontWeight="Bold" Foreground="#776E65"/>
                <Button Background="#BBADA0" Content="Нова гра" Click="Restart_Click" Style="{StaticResource MainButtonStyle}" 
                Width="90" Height="32" Margin="15,0,0,0" Padding="0"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Border Background="#BBADA0" CornerRadius="5" Padding="10,5" Margin="3,0">
                    <StackPanel>
                        <TextBlock Text="РАХУНОК" FontSize="10" Foreground="#EEE4DA" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="lblScore" Text="0" FontSize="16" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Background="#BBADA0" CornerRadius="5" Padding="10,5" Margin="3,0">
                    <StackPanel>
                        <TextBlock Text="РЕКОРД" FontSize="10" Foreground="#EEE4DA" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="lblHighScore" Text="0" FontSize="16" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>


        <!-- Игровое поле 4х4 -->
        <Border Background="#BBADA0" CornerRadius="8" Grid.Row="1" Padding="6">
            <UniformGrid Columns="4" Rows="4" x:Name="GameGrid"/>
        </Border>
    </Grid>
</Window>