<Window x:Class="TestingSystem.Views.StudentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Кабінет студента — тиждень 3" Height="350" Width="600">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Доступні тести (проходження — тиждень 5)" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <Button Content="Вийти" Width="80" Click="OnLogout"/>
        </StackPanel>
        <ListBox x:Name="TestsList" DisplayMemberPath="Title"/>
    </DockPanel>
</Window>
