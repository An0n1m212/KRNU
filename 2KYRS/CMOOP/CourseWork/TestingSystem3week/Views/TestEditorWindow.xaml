<Window x:Class="TestingSystem.Views.TestEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Конструктор тесту — тиждень 3" Height="560" Width="760">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Назва"/><TextBox x:Name="TitleBox" Margin="0,0,0,6"/>
            <TextBlock Text="Опис"/><TextBox x:Name="DescBox" Margin="0,0,0,6"/>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Прохідний бал %" VerticalAlignment="Center"/>
                <TextBox x:Name="PassBox" Width="60" Margin="8,0,0,0"/>
            </StackPanel>
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,10,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>
            <GroupBox Header="Питання">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Content="Додати" Width="80" Click="OnAdd"/>
                        <Button Content="Видалити" Width="80" Margin="6,0,0,0" Click="OnDelete"/>
                    </StackPanel>
                    <ListBox x:Name="QuestionsList" DisplayMemberPath="Text" SelectionChanged="OnSelect"/>
                </DockPanel>
            </GroupBox>
            <GroupBox Header="Питання (один / кілька / текст)" Grid.Column="1" Margin="8,0,0,0">
                <StackPanel Margin="8">
                    <TextBlock Text="Тип (тиждень 4 додасть пари, послідовність, файл)"/>
                    <ComboBox x:Name="TypeBox" Margin="0,0,0,6"/>
                    <TextBlock Text="Текст питання"/>
                    <TextBox x:Name="QTextBox" Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Бал" VerticalAlignment="Center"/>
                        <TextBox x:Name="ScoreBox" Width="60" Margin="8,0,0,0"/>
                    </StackPanel>
                    <TextBlock Text="Варіанти (кожен з нового рядка)" Margin="0,6,0,0"/>
                    <TextBox x:Name="AnswersBox" Height="90" AcceptsReturn="True"/>
                    <TextBlock Text="Індекси правильних (через кому, з 0). Для тексту — ігнорується"/>
                    <TextBox x:Name="CorrectBox" Margin="0,0,0,6"/>
                    <Button Content="Застосувати до питання" Click="OnApply"/>
                </StackPanel>
            </GroupBox>
        </Grid>
        <StackPanel Grid.Row="2" Orientation="Horizontal">
            <Button Content="Зберегти тест" Width="130" Click="OnSave"/>
            <TextBlock x:Name="ErrorText" Foreground="Red" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</Window>
