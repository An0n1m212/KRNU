<Window x:Class="TestingSystem.Views.LecturesView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Лекції — тиждень 7" Height="420" Width="680">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Нова" Width="90" Click="OnNew"/>
            <Button Content="Редагувати" Width="100" Margin="8,0,0,0" Click="OnEdit"/>
            <Button Content="Опублікувати/зняти" Width="150" Margin="8,0,0,0" Click="OnToggle"/>
            <Button Content="Видалити" Width="90" Margin="8,0,0,0" Click="OnDelete"/>
            <Button Content="Оновити" Width="90" Margin="8,0,0,0" Click="OnRefresh"/>
        </StackPanel>
        <ListBox x:Name="LecturesList"/>
    </DockPanel>
</Window>
