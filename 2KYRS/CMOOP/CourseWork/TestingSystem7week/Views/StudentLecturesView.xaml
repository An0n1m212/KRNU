<Window x:Class="TestingSystem.Views.StudentLecturesView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Лекції — студент" Height="520" Width="780">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <DockPanel>
            <Button DockPanel.Dock="Bottom" Content="До рекомендованого тесту" Margin="0,8,0,0" Click="OnRelated"/>
            <ListBox x:Name="LecturesList" DisplayMemberPath="Title" SelectionChanged="OnSelect"/>
        </DockPanel>
        <GroupBox Header="Читання" Grid.Column="1" Margin="8,0,0,0">
            <FlowDocumentScrollViewer x:Name="Preview"/>
        </GroupBox>
    </Grid>
</Window>
