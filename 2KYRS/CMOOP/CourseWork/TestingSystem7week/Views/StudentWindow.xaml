<Window x:Class="TestingSystem.Views.StudentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Кабінет студента — тиждень 7" Height="600" Width="760">
    <DockPanel Margin="16">
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock x:Name="UserText" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <TextBlock Text="Мова" VerticalAlignment="Center"/>
            <ComboBox x:Name="LangBox" Width="80" Margin="6,0,12,0" SelectionChanged="OnLang"/>
            <TextBlock Text="Тема" VerticalAlignment="Center"/>
            <ComboBox x:Name="ThemeBox" Width="100" Margin="6,0,12,0" SelectionChanged="OnTheme"/>
            <Button Content="Заблокувати" Width="110" Click="OnLock"/>
            <Button Content="Вийти" Width="80" Margin="8,0,0,0" Click="OnLogout"/>
        </WrapPanel>
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <Button Content="Почати" Width="90" Click="OnStart"/>
            <Button Content="Розбір" Width="90" Margin="8,0,0,0" Click="OnDetails"/>
            <Button Content="Сертифікат PDF" Width="130" Margin="8,0,0,0" Click="OnCertificate"/>
            <Button Content="Лекції" Width="90" Margin="8,0,0,0" Click="OnLectures"/>
        </WrapPanel>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <GroupBox Header="Доступні тести">
                <ListBox x:Name="TestsList"/>
            </GroupBox>
            <GroupBox Header="Мої результати" Grid.Row="1" Margin="0,8,0,0">
                <ListBox x:Name="ResultsList"/>
            </GroupBox>
        </Grid>
    </DockPanel>
</Window>
