<Window x:Class="TestingSystem.Views.AccessCodeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Пін-код" Height="180" Width="320" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="16">
        <TextBlock Text="Тест захищено. Введіть пін-код (демо: 1234)."/>
        <PasswordBox x:Name="PinBox" Margin="0,10,0,10"/>
        <StackPanel Orientation="Horizontal">
            <Button Content="OK" Width="90" IsDefault="True" Click="OnOk"/>
            <Button Content="Скасувати" Width="90" Margin="8,0,0,0" Click="OnCancel"/>
        </StackPanel>
    </StackPanel>
</Window>
