<Window x:Class="TestingSystem.Views.LectureEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактор лекції — тиждень 7 (Markdown)" Height="600" Width="860">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Назва"/><TextBox x:Name="TitleBox" Margin="0,0,0,4"/>
            <TextBlock Text="Короткий опис"/><TextBox x:Name="SummaryBox" Margin="0,0,0,4"/>
            <WrapPanel>
                <CheckBox x:Name="PublishBox" Content="Опубліковано" Margin="0,0,16,0"/>
                <TextBlock Text="Рекомендований тест" VerticalAlignment="Center"/>
                <ComboBox x:Name="TestBox" DisplayMemberPath="Title" Width="220" Margin="6,0,0,0"/>
            </WrapPanel>
            <TextBlock Text="Групи (порожньо — усім)" Margin="0,6,0,0"/>
            <ListBox x:Name="GroupsBox" DisplayMemberPath="Name" Height="56" SelectionMode="Multiple"/>
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,8,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <GroupBox Header="Markdown: заголовки, списки, код">
                <TextBox x:Name="ContentBox" AcceptsReturn="True" TextChanged="OnText"/>
            </GroupBox>
            <GroupBox Header="Перегляд" Grid.Column="1" Margin="8,0,0,0">
                <FlowDocumentScrollViewer x:Name="Preview"/>
            </GroupBox>
        </Grid>
        <StackPanel Grid.Row="2" Orientation="Horizontal">
            <Button Content="Зберегти" Width="120" Click="OnSave"/>
            <TextBlock x:Name="ErrorText" Foreground="Red" Margin="12,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>
