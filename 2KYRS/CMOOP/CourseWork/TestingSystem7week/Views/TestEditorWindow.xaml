<Window x:Class="TestingSystem.Views.TestEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Конструктор тесту — тиждень 4 (усі 6 типів)" Height="640" Width="820">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <GroupBox Header="Налаштування тесту (ТЗ п.3.3.1)">
            <WrapPanel Margin="8">
                <StackPanel Width="360" Margin="0,0,16,0">
                    <TextBlock Text="Назва"/><TextBox x:Name="TitleBox" Margin="0,0,0,4"/>
                    <TextBlock Text="Опис"/><TextBox x:Name="DescBox" Margin="0,0,0,4"/>
                    <TextBlock Text="Пін-код (порожньо — відкритий)"/><TextBox x:Name="PinBox" Margin="0,0,0,4"/>
                </StackPanel>
                <StackPanel Width="180" Margin="0,0,16,0">
                    <TextBlock Text="Ліміт часу, хв (0 — без)"/><TextBox x:Name="TimeBox" Margin="0,0,0,4"/>
                    <TextBlock Text="Спроби (0 — безліміт)"/><TextBox x:Name="AttemptsBox" Margin="0,0,0,4"/>
                    <TextBlock Text="Прохідний бал %"/><TextBox x:Name="PassBox" Margin="0,0,0,4"/>
                </StackPanel>
                <StackPanel Width="200">
                    <CheckBox x:Name="ShuffleQBox" Content="Перемішувати питання"/>
                    <CheckBox x:Name="ShuffleABox" Content="Перемішувати варіанти"/>
                    <CheckBox x:Name="ExplainBox" Content="Показ пояснень"/>
                    <TextBlock Text="Групи (порожньо — усім)" Margin="0,6,0,0"/>
                    <ListBox x:Name="GroupsBox" DisplayMemberPath="Name" Height="70" SelectionMode="Multiple"/>
                </StackPanel>
            </WrapPanel>
        </GroupBox>
        <Grid Grid.Row="1" Margin="0,10,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>
            <GroupBox Header="Питання (6 типів, ТЗ п.3.3.2)">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Content="Додати" Width="80" Click="OnAdd"/>
                        <Button Content="Видалити" Width="80" Margin="6,0,0,0" Click="OnDelete"/>
                    </StackPanel>
                    <ListBox x:Name="QuestionsList" DisplayMemberPath="Text" SelectionChanged="OnSelect"/>
                </DockPanel>
            </GroupBox>
            <GroupBox Header="Редактор питання" Grid.Column="1" Margin="8,0,0,0">
                <ScrollViewer><StackPanel Margin="8">
                    <TextBlock Text="Тип"/>
                    <ComboBox x:Name="TypeBox" Margin="0,0,0,6"/>
                    <TextBlock Text="Текст питання"/>
                    <TextBox x:Name="QTextBox" Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Бал" VerticalAlignment="Center"/>
                        <TextBox x:Name="ScoreBox" Width="60" Margin="8,0,16,0"/>
                        <TextBlock Text="Пояснення" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBox x:Name="ExplBox" Margin="0,0,0,6"/>
                    <TextBlock x:Name="AnswersHint" TextWrapping="Wrap" Margin="0,0,0,2"/>
                    <TextBox x:Name="AnswersBox" Height="110" AcceptsReturn="True"/>
                    <TextBlock Text="Індекси правильних (через кому, з 0). Для тексту/пар/послідовності/файлу — ігнорується або за підказкою"/>
                    <TextBox x:Name="CorrectBox" Margin="0,0,0,6"/>
                    <Button Content="Застосувати до питання" Click="OnApply"/>
                </StackPanel></ScrollViewer>
            </GroupBox>
        </Grid>
        <StackPanel Grid.Row="2" Orientation="Horizontal">
            <Button Content="Зберегти тест" Width="130" Click="OnSave"/>
            <TextBlock x:Name="ErrorText" Foreground="Red" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</Window>
