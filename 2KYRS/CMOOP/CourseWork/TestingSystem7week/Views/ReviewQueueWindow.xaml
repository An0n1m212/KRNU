<Window x:Class="TestingSystem.Views.ReviewQueueWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Черга перевірки — тиждень 6" Height="400" Width="640">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Роботи зі статусом «на перевірці»" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <Button Content="Перевірити" Width="110" Click="OnOpen"/>
            <Button Content="Оновити" Width="90" Margin="8,0,0,0" Click="OnRefresh"/>
        </StackPanel>
        <ListBox x:Name="QueueList"/>
    </DockPanel>
</Window>
