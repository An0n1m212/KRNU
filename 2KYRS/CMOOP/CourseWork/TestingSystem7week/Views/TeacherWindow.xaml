<Window x:Class="TestingSystem.Views.TeacherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Місце викладача — тиждень 7" Height="520" Width="820">
    <DockPanel Margin="16">
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="Мова" VerticalAlignment="Center"/>
            <ComboBox x:Name="LangBox" Width="80" Margin="6,0,12,0" SelectionChanged="OnLang"/>
            <TextBlock Text="Тема" VerticalAlignment="Center"/>
            <ComboBox x:Name="ThemeBox" Width="100" Margin="6,0,12,0" SelectionChanged="OnTheme"/>
            <Button Content="Заблокувати" Width="110" Click="OnLock"/>
            <Button Content="Вийти" Width="80" Margin="8,0,0,0" Click="OnLogout"/>
        </WrapPanel>
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <Button Content="Новий тест" Width="110" Click="OnNew"/>
            <Button Content="Редагувати" Width="110" Margin="8,0,0,0" Click="OnEdit"/>
            <Button Content="Видалити" Width="100" Margin="8,0,0,0" Click="OnDelete"/>
            <Button Content="На перевірці" Width="110" Margin="16,0,0,0" Click="OnReview"/>
            <Button Content="Журнал" Width="90" Margin="8,0,0,0" Click="OnJournal"/>
            <Button Content="Аналітика" Width="90" Margin="8,0,0,0" Click="OnAnalytics"/>
            <Button Content="Лекції" Width="90" Margin="8,0,0,0" Click="OnLectures"/>
            <Button Content="Групи" Width="90" Margin="8,0,0,0" Click="OnGroups"/>
        </WrapPanel>
        <ListBox x:Name="TestsList" DisplayMemberPath="Title"/>
    </DockPanel>
</Window>
