<Window x:Class="TestingSystem.Views.JournalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Журнал — тиждень 6" Height="520" Width="860">
    <DockPanel Margin="16">
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="Група" VerticalAlignment="Center"/>
            <ComboBox x:Name="GroupBox" DisplayMemberPath="Name" Width="140" Margin="6,0,12,0" SelectionChanged="OnFilter"/>
            <TextBlock Text="Тест" VerticalAlignment="Center"/>
            <ComboBox x:Name="TestBox" DisplayMemberPath="Title" Width="200" Margin="6,0,12,0" SelectionChanged="OnFilter"/>
            <Button Content="CSV" Width="70" Click="OnCsv"/>
            <Button Content="Excel" Width="70" Margin="6,0,0,0" Click="OnExcel"/>
            <Button Content="PDF-звіт" Width="90" Margin="6,0,0,0" Click="OnPdf"/>
        </WrapPanel>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="3*"/>
                <RowDefinition Height="2*"/>
            </Grid.RowDefinitions>
            <GroupBox Header="Результати (ТЗ п.3.8.1)">
                <ListBox x:Name="RowsList"/>
            </GroupBox>
            <GroupBox Header="Складність питань: ≥50% неповних — складні (ТЗ п.3.8.2)" Grid.Row="1" Margin="0,8,0,0">
                <ListBox x:Name="HardList"/>
            </GroupBox>
        </Grid>
    </DockPanel>
</Window>
