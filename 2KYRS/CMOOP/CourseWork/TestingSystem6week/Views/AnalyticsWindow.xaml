<Window x:Class="TestingSystem.Views.AnalyticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Аналітика — тиждень 6" Height="440" Width="680">
    <ScrollViewer><StackPanel Margin="16">
        <TextBlock x:Name="TeacherText" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <TextBlock Text="Статистика за групами" FontWeight="Bold"/>
        <ListBox x:Name="GroupsList" Height="120" Margin="0,4,0,8"/>
        <TextBlock Text="Динаміка студента" FontWeight="Bold"/>
        <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
            <ComboBox x:Name="StudentBox" DisplayMemberPath="FullName" Width="220" SelectionChanged="OnStudent"/>
        </StackPanel>
        <ListBox x:Name="ProgressList" Height="120"/>
    </StackPanel></ScrollViewer>
</Window>
