<Window x:Class="TestingSystem.Views.TestRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Проходження тесту — тиждень 5" Height="560" Width="860">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock x:Name="TitleText" FontSize="15" VerticalAlignment="Center" Margin="0,0,16,0"/>
            <TextBlock x:Name="TimerText" VerticalAlignment="Center" Margin="0,0,16,0"/>
            <TextBlock x:Name="AnsweredText" VerticalAlignment="Center" Margin="0,0,16,0"/>
            <TextBlock x:Name="ViolationsText" VerticalAlignment="Center"/>
        </StackPanel>
        <TextBlock x:Name="BannerText" DockPanel.Dock="Top" Foreground="DarkRed" Margin="0,0,0,8" Visibility="Collapsed"/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="‹ Назад" Width="90" Click="OnPrev"/>
            <Button Content="Далі ›" Width="90" Margin="8,0,0,0" Click="OnNext"/>
            <Button Content="Здати тест" Width="110" Margin="16,0,0,0" Click="OnSubmit"/>
        </StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <GroupBox Header="Питання">
                <ListBox x:Name="NavList" SelectionChanged="OnNav"/>
            </GroupBox>
            <GroupBox Header="Відповідь" Grid.Column="1" Margin="8,0,0,0">
                <ScrollViewer><StackPanel x:Name="QuestionPanel" Margin="8"/></ScrollViewer>
            </GroupBox>
        </Grid>
    </DockPanel>
</Window>
