<UserControl x:Class="TestingSystem.Views.AiAssistantView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:TestingSystem.Infrastructure">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20" MaxWidth="900" HorizontalAlignment="Left">

            <!-- Провайдер та стан -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="{loc:T Ai_Settings}" Command="{Binding OpenSettingsCommand}" Padding="12,5" />
                        <TextBlock Text="{loc:T Ai_Title}" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Text="{Binding ProviderText}" Margin="0,6,0,0" />
                    <TextBlock Text="{loc:T Ai_MockWarning}" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{DynamicResource WarningBrush}"
                               Visibility="{Binding IsMockProvider, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{loc:T Ai_Review}" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="12"
                               Foreground="{DynamicResource SecondaryTextBrush}" />

                    <ProgressBar IsIndeterminate="True" Height="6" Margin="0,10,0,0"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                    <Button Content="{loc:T Btn_Cancel}" Command="{Binding CancelOperationCommand}" Padding="10,3" Margin="0,8,0,0"
                            HorizontalAlignment="Left" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource SuccessBrush}" />
                    <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource ErrorBrush}" />
                </StackPanel>
            </Border>

            <!-- 1. Теми лекцій -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="{loc:T Ai_TopicsCard}" FontSize="17" FontWeight="Bold" />
                    <TextBlock Text="{loc:T Ai_Subject}" Margin="0,10,0,2" />
                    <TextBox Text="{Binding Subject, UpdateSourceTrigger=PropertyChanged}" Padding="4" />

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="{loc:T Ai_Count}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox ItemsSource="{Binding TopicCounts}" SelectedItem="{Binding TopicCount}" Width="70" Margin="0,0,16,0" />
                        <Button Content="{loc:T Ai_GenerateTopics}" Command="{Binding SuggestTopicsCommand}" Padding="12,5" />
                    </StackPanel>

                    <ListBox ItemsSource="{Binding Suggestions}" SelectedItem="{Binding SelectedSuggestion}" Margin="0,10,0,0" MaxHeight="220"
                             HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="12"
                                               Foreground="{DynamicResource SecondaryTextBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button Content="{loc:T Ai_LectureFromTopic}" Command="{Binding LectureFromSuggestionCommand}" Padding="12,5"
                            HorizontalAlignment="Left" Margin="0,10,0,0" />
                </StackPanel>
            </Border>

            <!-- 2. Лекція -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="{loc:T Ai_LectureCard}" FontSize="17" FontWeight="Bold" />
                    <TextBlock Text="{loc:T Ai_TopicLabel}" Margin="0,10,0,2" />
                    <TextBox Text="{Binding LectureTopic, UpdateSourceTrigger=PropertyChanged}" Padding="4" />
                    <Button Content="{loc:T Ai_GenerateLecture}" Command="{Binding GenerateLectureCommand}" Padding="12,5"
                            HorizontalAlignment="Left" Margin="0,10,0,0" />
                </StackPanel>
            </Border>

            <!-- 3. Тест -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="{loc:T Ai_TestCard}" FontSize="17" FontWeight="Bold" />
                    <TextBlock Text="{loc:T Ai_TestTopic}" Margin="0,10,0,2" />
                    <TextBox Text="{Binding TestTopic, UpdateSourceTrigger=PropertyChanged}" Padding="4" />

                    <TextBlock Text="{loc:T Ai_SourceLecture}" Margin="0,10,0,2" />
                    <ComboBox ItemsSource="{Binding SourceLectures}" SelectedItem="{Binding SelectedSourceLecture}"
                              DisplayMemberPath="Title" Padding="4" />

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="{loc:T Ai_QuestionCount}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox ItemsSource="{Binding QuestionCounts}" SelectedItem="{Binding QuestionCount}" Width="70" />
                    </StackPanel>

                    <TextBlock Text="{loc:T Ai_QuestionTypes}" Margin="0,10,0,2" />
                    <WrapPanel>
                        <CheckBox Content="{loc:T QType_SingleChoice}" IsChecked="{Binding IncludeSingle}" Margin="0,2,16,2" />
                        <CheckBox Content="{loc:T QType_MultipleChoice}" IsChecked="{Binding IncludeMultiple}" Margin="0,2,16,2" />
                        <CheckBox Content="{loc:T QType_TextAnswer}" IsChecked="{Binding IncludeText}" Margin="0,2,16,2" />
                        <CheckBox Content="{loc:T QType_Matching}" IsChecked="{Binding IncludeMatching}" Margin="0,2,16,2" />
                        <CheckBox Content="{loc:T QType_Sequence}" IsChecked="{Binding IncludeSequence}" Margin="0,2,16,2" />
                    </WrapPanel>

                    <Button Content="{loc:T Ai_GenerateTest}" Command="{Binding GenerateTestCommand}" Padding="12,5"
                            HorizontalAlignment="Left" Margin="0,10,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
