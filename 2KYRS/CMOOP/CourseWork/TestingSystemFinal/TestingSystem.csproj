<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- WPF0001: Application.ThemeMode (встроенная Fluent-тема WPF) — experimental API -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- DI-контейнер: подмена InMemory -> SQLite/EF Core делается одной строкой регистрации в App.xaml.cs -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
    <!-- Генерация PDF (сертификаты и отчёты). Community-лицензия QuestPDF бесплатна для небольших организаций -->
    <PackageReference Include="QuestPDF" Version="2024.10.2" />
  </ItemGroup>
</Project>
