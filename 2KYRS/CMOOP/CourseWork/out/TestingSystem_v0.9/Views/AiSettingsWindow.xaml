<Window x:Class="TestingSystem.Views.AiSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:TestingSystem.Infrastructure"
        Width="580" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <StackPanel Margin="22">
        <TextBlock Text="{loc:T Ai_Privacy}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource WarningBrush}" Margin="0,0,0,10" />

        <Expander Header="{loc:T Ai_HelpTitle}" Margin="0,0,0,14" IsExpanded="False">
            <TextBlock Text="{loc:T Ai_HelpSteps}" TextWrapping="Wrap" FontSize="12"
                       Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,6,0,0" />
        </Expander>

        <TextBlock Text="{loc:T Ai_ProviderLabel}" />
        <ComboBox ItemsSource="{Binding Providers}" SelectedItem="{Binding SelectedProvider}" DisplayMemberPath="Text"
                  Padding="4" Margin="0,2,0,10" />

        <StackPanel IsEnabled="{Binding IsExternal}">
            <TextBlock Text="{loc:T Ai_BaseUrl}" />
            <TextBox Text="{Binding BaseUrl, UpdateSourceTrigger=PropertyChanged}" Padding="4" Margin="0,2,0,10" />

            <TextBlock Text="{loc:T Ai_Model}" />
            <TextBox Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}" Padding="4" Margin="0,2,0,10" />

            <TextBlock Text="{loc:T Ai_ApiKey}" />
            <PasswordBox Padding="4" Margin="0,2,0,4"
                         loc:PasswordBoxAssistant.BoundPassword="{Binding ApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <DockPanel Margin="0,0,0,10">
                <Button DockPanel.Dock="Right" Content="{loc:T Ai_RemoveKey}" Command="{Binding RemoveKeyCommand}" Padding="10,3" />
                <TextBlock Text="{Binding KeyHint}" FontSize="12" VerticalAlignment="Center"
                           Foreground="{DynamicResource SecondaryTextBrush}" />
            </DockPanel>

            <TextBlock Text="{loc:T Ai_Timeout}" />
            <TextBox Text="{Binding TimeoutText, UpdateSourceTrigger=PropertyChanged}" Padding="4" Width="90" HorizontalAlignment="Left" Margin="0,2,0,10" />
        </StackPanel>

        <ProgressBar IsIndeterminate="True" Height="6" Margin="0,4,0,0"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
        <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource SuccessBrush}" />
        <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource ErrorBrush}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{loc:T Ai_TestConnection}" Command="{Binding TestCommand}" Padding="12,6" Margin="0,0,8,0" />
            <Button Content="{loc:T Btn_SaveSettings}" Command="{Binding SaveCommand}" Padding="16,6" Margin="0,0,8,0" FontWeight="Bold" />
            <Button Content="{loc:T Btn_Cancel}" Command="{Binding CloseCommand}" Padding="16,6" />
        </StackPanel>
    </StackPanel>
</Window>
