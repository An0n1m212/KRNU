<Window x:Class="TestingSystem.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:TestingSystem.Views"
        xmlns:loc="clr-namespace:TestingSystem.Infrastructure"
        Title="{loc:T App_Title}" Width="430" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{DynamicResource HeaderBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="10,6">
            <v:SettingsPanel x:Name="Settings" HorizontalAlignment="Right" />
        </Border>

        <StackPanel Margin="28,20,28,24">
            <TextBlock Text="{loc:T App_Title}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" />
            <TextBlock x:Name="ModeTitle" FontSize="15" Foreground="{DynamicResource SecondaryTextBrush}"
                       HorizontalAlignment="Center" Margin="0,4,0,16" />

            <StackPanel x:Name="FullNamePanel" Visibility="Collapsed">
                <TextBlock Text="{loc:T Field_FullName}" />
                <TextBox x:Name="FullNameBox" Padding="4" Margin="0,2,0,10" />
            </StackPanel>

            <TextBlock Text="{loc:T Field_Username}" />
            <TextBox x:Name="UsernameBox" Padding="4" Margin="0,2,0,10" />

            <TextBlock Text="{loc:T Field_Password}" />
            <PasswordBox x:Name="PasswordInput" Padding="4" Margin="0,2,0,10" />

            <StackPanel x:Name="ExtraPanel" Visibility="Collapsed">
                <TextBlock Text="{loc:T Field_Email}" />
                <TextBox x:Name="EmailBox" Padding="4" Margin="0,2,0,10" />
                <TextBlock Text="{loc:T Field_Group}" />
                <ComboBox x:Name="GroupCombo" DisplayMemberPath="Name" Padding="4" Margin="0,2,0,10" />
            </StackPanel>

            <TextBlock x:Name="ErrorText" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />

            <Button x:Name="SubmitButton" IsDefault="True" Padding="10,6" MinWidth="180" HorizontalAlignment="Center" Click="Submit_Click" />
            <Button x:Name="SwitchModeButton" Margin="0,10,0,0" HorizontalAlignment="Center" Background="Transparent" BorderThickness="0"
                    Cursor="Hand" Click="SwitchMode_Click" />

            <TextBlock Text="{loc:T Login_DemoHint}" Foreground="{DynamicResource SecondaryTextBrush}"
                       FontSize="11" HorizontalAlignment="Center" Margin="0,14,0,0" TextWrapping="Wrap" TextAlignment="Center" />
        </StackPanel>
    </DockPanel>
</Window>
