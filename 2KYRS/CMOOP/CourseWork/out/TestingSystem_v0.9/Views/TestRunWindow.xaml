<Window x:Class="TestingSystem.Views.TestRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:TestingSystem.Infrastructure"
        Width="1020" Height="740" MinWidth="800" MinHeight="560" WindowStartupLocation="CenterOwner">
    <Grid>
        <!-- ===== сам тест ===== -->
        <Grid x:Name="RunGrid" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0">
                <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <TextBlock x:Name="TimerText" FontSize="28" FontWeight="Bold" HorizontalAlignment="Right" />
                    <TextBlock x:Name="ViolationsText" FontSize="12" HorizontalAlignment="Right"
                               Foreground="{DynamicResource SecondaryTextBrush}" />
                </StackPanel>
                <TextBlock x:Name="TestTitleText" FontSize="22" FontWeight="Bold" TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>

            <!-- баннер предупреждений: таймер, античит -->
            <Border x:Name="Banner" Grid.Row="1" Visibility="Collapsed" Margin="0,8,0,0" Padding="10,6" CornerRadius="4"
                    Background="{DynamicResource HardRowBrush}">
                <TextBlock x:Name="BannerText" TextWrapping="Wrap" FontWeight="SemiBold" />
            </Border>

            <Grid Grid.Row="2" Margin="0,12,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="210" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- навигация по вопросам + статус-бар отвеченных -->
                <Border Style="{StaticResource CardStyle}" Padding="12" Margin="0">
                    <StackPanel>
                        <TextBlock Text="{loc:T Run_Navigation}" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <WrapPanel x:Name="NavPanel" />
                        <ProgressBar x:Name="AnsweredBar" Height="8" Margin="0,14,0,4" />
                        <TextBlock x:Name="AnsweredText" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock x:Name="QuestionHeader" Foreground="{DynamicResource SecondaryTextBrush}" />
                        <Image x:Name="MediaImage" MaxHeight="240" HorizontalAlignment="Left" Margin="0,8,0,0" Visibility="Collapsed" />
                        <TextBlock x:Name="QuestionText" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,4" />
                        <TextBlock x:Name="HintText" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,12" TextWrapping="Wrap" />
                        <ContentControl x:Name="ContentHost" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <DockPanel Grid.Row="3">
                <Button DockPanel.Dock="Right" Content="{loc:T Run_Submit}" Padding="20,8" FontWeight="Bold" Click="Submit_Click" />
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="PrevButton" Content="{loc:T Run_Prev}" Padding="16,8" Margin="0,0,8,0" Click="Prev_Click" />
                    <Button x:Name="NextButton" Content="{loc:T Run_Next}" Padding="16,8" Click="Next_Click" />
                </StackPanel>
            </DockPanel>
        </Grid>

        <!-- ===== итог (показывается после сдачи / по таймауту) ===== -->
        <Border x:Name="ResultOverlay" Visibility="Collapsed" Background="{DynamicResource CardBackgroundBrush}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560">
                <TextBlock x:Name="ResultTitle" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
                <TextBlock x:Name="ResultBody" FontSize="18" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="0,14,0,24" />
                <Button Content="{loc:T Btn_Close}" Padding="24,8" HorizontalAlignment="Center" Click="Close_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
