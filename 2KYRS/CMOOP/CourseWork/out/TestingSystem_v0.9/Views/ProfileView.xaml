<UserControl x:Class="TestingSystem.Views.ProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:TestingSystem.Views"
             xmlns:loc="clr-namespace:TestingSystem.Infrastructure">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="1.2*" />
            </Grid.ColumnDefinitions>

            <!-- ============ Левая колонка: профиль + безопасность ============ -->
            <StackPanel Grid.Column="0">
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="{loc:T Prof_Card}" FontSize="18" FontWeight="Bold" Margin="0,0,0,12" />

                        <StackPanel Orientation="Horizontal">
                            <v:AvatarView x:Name="Avatar" Width="96" Height="96" />
                            <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="UsernameText" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock x:Name="RoleText" Foreground="{DynamicResource SecondaryTextBrush}" />
                                <TextBlock x:Name="GroupText" Foreground="{DynamicResource SecondaryTextBrush}" />
                                <TextBlock x:Name="RegisteredText" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="{loc:T Btn_ChoosePhoto}" Padding="10,4" Margin="0,0,6,0" Click="ChoosePhoto_Click" />
                                    <Button Content="{loc:T Btn_RemovePhoto}" Padding="10,4" Click="RemovePhoto_Click" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="{loc:T Field_FullName}" Margin="0,14,0,2" />
                        <TextBox x:Name="FullNameBox" Padding="4" />
                        <TextBlock Text="{loc:T Field_Email}" Margin="0,10,0,2" />
                        <TextBox x:Name="EmailBox" Padding="4" />

                        <Button Content="{loc:T Btn_SaveProfile}" Padding="14,6" HorizontalAlignment="Left" Margin="0,14,0,0" Click="SaveProfile_Click" />
                        <TextBlock x:Name="ProfileStatus" TextWrapping="Wrap" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="{loc:T Prof_Security}" FontSize="18" FontWeight="Bold" Margin="0,0,0,8" />
                        <TextBlock Text="{loc:T Field_OldPassword}" Margin="0,6,0,2" />
                        <PasswordBox x:Name="OldPasswordBox" Padding="4" />
                        <TextBlock Text="{loc:T Field_NewPassword}" Margin="0,10,0,2" />
                        <PasswordBox x:Name="NewPasswordBox" Padding="4" />
                        <TextBlock Text="{loc:T Field_ConfirmPassword}" Margin="0,10,0,2" />
                        <PasswordBox x:Name="ConfirmPasswordBox" Padding="4" />
                        <Button Content="{loc:T Btn_ChangePassword}" Padding="14,6" HorizontalAlignment="Left" Margin="0,14,0,0" Click="ChangePassword_Click" />
                        <TextBlock x:Name="PasswordStatus" TextWrapping="Wrap" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="{loc:T Prof_Settings}" FontSize="18" FontWeight="Bold" Margin="0,0,0,10" />
                        <v:SettingsPanel x:Name="Settings" HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ============ Правая колонка: статистика (зависит от роли) ============ -->
            <StackPanel Grid.Column="2">

                <!-- Блок статистики ученика -->
                <StackPanel x:Name="StudentPanel">
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="{loc:T Prof_Stats}" FontSize="18" FontWeight="Bold" Margin="0,0,0,10" />
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                <TextBlock Text="{loc:T Stat_TestsCompleted}" Grid.Row="0" Margin="0,4" />
                                <TextBlock x:Name="SCompleted" Grid.Row="0" Grid.Column="1" FontWeight="Bold" Margin="12,4" />
                                <TextBlock Text="{loc:T Stat_AvgScore}" Grid.Row="1" Margin="0,4" />
                                <TextBlock x:Name="SAverage" Grid.Row="1" Grid.Column="1" FontWeight="Bold" Margin="12,4" />
                                <TextBlock Text="{loc:T Stat_Certificates}" Grid.Row="2" Margin="0,4" />
                                <TextBlock x:Name="SCertificates" Grid.Row="2" Grid.Column="1" FontWeight="Bold" Margin="12,4" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="{loc:T Prof_Progress}" FontSize="18" FontWeight="Bold" Margin="0,0,0,8" />
                            <v:MiniLineChart x:Name="Chart" Height="170" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="{loc:T Prof_Certificates}" FontSize="18" FontWeight="Bold" Margin="0,0,0,8" />
                            <DataGrid x:Name="CertGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                                      CanUserAddRows="False" SelectionMode="Single" MaxHeight="180">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{loc:T Col_Test}" Binding="{Binding Test}" Width="*" />
                                    <DataGridTextColumn Header="%" Binding="{Binding Percent, StringFormat=0.#}" Width="60" />
                                    <DataGridTextColumn Header="{loc:T Col_Date}" Binding="{Binding Date, StringFormat=dd.MM.yyyy}" Width="100" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <Button Content="{loc:T Btn_DownloadCertificate}" Padding="12,5" HorizontalAlignment="Left" Margin="0,8,0,0"
                                    Click="Certificate_Click" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Блок статистики учителя и админа -->
                <StackPanel x:Name="TeacherPanel" Visibility="Collapsed">
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="{loc:T Prof_Stats}" FontSize="18" FontWeight="Bold" Margin="0,0,0,10" />
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                <TextBlock Text="{loc:T Stat_TestsCreated}" Grid.Row="0" Margin="0,4" />
                                <TextBlock x:Name="TCreated" Grid.Row="0" Grid.Column="1" FontWeight="Bold" Margin="12,4" />
                                <TextBlock Text="{loc:T Stat_WorksReviewed}" Grid.Row="1" Margin="0,4" />
                                <TextBlock x:Name="TReviewed" Grid.Row="1" Grid.Column="1" FontWeight="Bold" Margin="12,4" />
                                <TextBlock Text="{loc:T Stat_PendingReview}" Grid.Row="2" Margin="0,4" />
                                <TextBlock x:Name="TPending" Grid.Row="2" Grid.Column="1" FontWeight="Bold" Margin="12,4" />
                                <TextBlock Text="{loc:T Stat_AvgPerformance}" Grid.Row="3" Margin="0,4" />
                                <TextBlock x:Name="TAverage" Grid.Row="3" Grid.Column="1" FontWeight="Bold" Margin="12,4" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="{loc:T Prof_GroupStats}" FontSize="18" FontWeight="Bold" Margin="0,0,0,8" />
                            <DataGrid x:Name="GroupGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                                      CanUserAddRows="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{loc:T Col_Group}" Binding="{Binding GroupName}" Width="*" />
                                    <DataGridTextColumn Header="{loc:T Col_Students}" Binding="{Binding Students}" Width="80" />
                                    <DataGridTextColumn Header="{loc:T Col_Attempts}" Binding="{Binding Attempts}" Width="80" />
                                    <DataGridTextColumn Header="{loc:T Col_AvgPercent}" Binding="{Binding AveragePercent, StringFormat=0.#}" Width="80" />
                                    <DataGridTextColumn Header="{loc:T Col_PassRate}" Binding="{Binding PassRatePercent, StringFormat=0.#}" Width="90" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
