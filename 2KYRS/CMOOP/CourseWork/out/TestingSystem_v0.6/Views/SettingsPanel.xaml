<UserControl x:Class="TestingSystem.Views.SettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:TestingSystem.Infrastructure">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <ComboBox x:Name="LangCombo" Width="70" ToolTip="{loc:T Lang_Label}" SelectionChanged="Lang_Changed" />
        <Button x:Name="ThemeButton" Margin="8,0,0,0" Padding="10,4" ToolTip="{loc:T Theme_Toggle}" Click="Theme_Click" />
    </StackPanel>
</UserControl>
