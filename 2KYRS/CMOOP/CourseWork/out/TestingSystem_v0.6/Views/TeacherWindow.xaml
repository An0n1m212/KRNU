<Window x:Class="TestingSystem.Views.TeacherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:TestingSystem.Views"
        xmlns:loc="clr-namespace:TestingSystem.Infrastructure"
        Title="{loc:T Win_Teacher}" Height="760" Width="1100" WindowStartupLocation="CenterScreen">
    <DockPanel>
        <v:HeaderBar x:Name="Header" DockPanel.Dock="Top" />
        <TabControl x:Name="Tabs">
            <TabItem x:Name="TestsTab" Header="{loc:T Tab_Builder}" />
            <TabItem x:Name="LecturesTab" Header="{loc:T Tab_Lectures}" />
            <TabItem x:Name="ReviewTab" Header="{loc:T Tab_Review}" />
            <TabItem x:Name="AnalyticsTab" Header="{loc:T Tab_Analytics}" />
            <TabItem x:Name="GroupsTab" Header="{loc:T Tab_Groups}" />
            <TabItem x:Name="ProfileTab" Header="{loc:T Tab_Profile}" />
        </TabControl>
    </DockPanel>
</Window>
