<Window x:Class="TestingSystem.Views.TestEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:TestingSystem.Infrastructure"
        Width="1280" Height="800" MinWidth="1000" MinHeight="600" WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="270" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============ настройки теста ============ -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="{loc:T Lbl_TestSettings}" FontSize="16" FontWeight="Bold" Margin="0,0,0,8" />

                <TextBlock Text="{loc:T Lbl_TestTitle}" />
                <TextBox x:Name="TitleBox" Padding="4" Margin="0,2,0,8" />

                <TextBlock Text="{loc:T Lbl_Description}" />
                <TextBox x:Name="DescBox" Padding="4" Margin="0,2,0,8" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="52" />

                <TextBlock Text="{loc:T Lbl_Category}" />
                <ComboBox x:Name="CategoryCombo" IsEditable="True" DisplayMemberPath="Name" Padding="4" Margin="0,2,0,8" />

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{loc:T Lbl_TimeLimit}" TextWrapping="Wrap" FontSize="12" />
                        <TextBox x:Name="TimeBox" Padding="4" Margin="0,2,0,0" Text="0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{loc:T Lbl_PassPercent}" TextWrapping="Wrap" FontSize="12" />
                        <TextBox x:Name="PassBox" Padding="4" Margin="0,2,0,0" Text="60" />
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="{loc:T Lbl_MaxAttempts}" TextWrapping="Wrap" FontSize="12" />
                        <TextBox x:Name="AttemptsBox" Padding="4" Margin="0,2,0,0" Text="0" />
                    </StackPanel>
                </Grid>
                <TextBlock Text="{loc:T Hint_Zero}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,8" TextWrapping="Wrap" />

                <CheckBox x:Name="RandomQuestionsCheck" Content="{loc:T Chk_RandomQuestions}" Margin="0,2" />
                <CheckBox x:Name="RandomAnswersCheck" Content="{loc:T Chk_RandomAnswers}" Margin="0,2" />
                <CheckBox x:Name="ExplanationsCheck" Content="{loc:T Chk_ShowExplanations}" Margin="0,2" IsChecked="True" />

                <TextBlock Text="{loc:T Lbl_AccessCode}" Margin="0,10,0,0" />
                <TextBox x:Name="AccessCodeBox" Padding="4" Margin="0,2,0,8" />

                <TextBlock Text="{loc:T Lbl_AssignedGroups}" />
                <ListBox x:Name="GroupsList" SelectionMode="Multiple" DisplayMemberPath="Name" Height="100" Margin="0,2,0,0" />
                <TextBlock Text="{loc:T Hint_Groups}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <!-- ============ список вопросов ============ -->
        <DockPanel Grid.Column="2">
            <TextBlock DockPanel.Dock="Top" Text="{loc:T Lbl_QuestionsList}" FontSize="16" FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap" />
            <ListBox x:Name="QuestionsList" DisplayMemberPath="Text"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionChanged="QuestionsList_SelectionChanged" />
        </DockPanel>

        <!-- ============ редактор вопроса ============ -->
        <ScrollViewer Grid.Column="4" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="{loc:T Lbl_QuestionEditor}" FontSize="16" FontWeight="Bold" Margin="0,0,0,8" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{loc:T Lbl_QuestionType}" />
                        <ComboBox x:Name="QTypeCombo" DisplayMemberPath="Text" Padding="4" Margin="0,2,0,0"
                                  SelectionChanged="TypeChanged" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" x:Name="TextEvalPanel" Visibility="Collapsed">
                        <TextBlock Text="{loc:T Lbl_TextEvaluation}" />
                        <ComboBox x:Name="TextEvalCombo" DisplayMemberPath="Text" Padding="4" Margin="0,2,0,0"
                                  SelectionChanged="TypeChanged" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="{loc:T Lbl_QuestionText}" Margin="0,10,0,0" />
                <TextBox x:Name="QTextBox" Padding="4" Margin="0,2,0,0" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56" />

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{loc:T Lbl_MaxScore}" />
                        <TextBox x:Name="MaxScoreBox" Padding="4" Margin="0,2,0,0" Text="1" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{loc:T Lbl_Media}" />
                        <DockPanel Margin="0,2,0,0">
                            <Button DockPanel.Dock="Right" Content="✕" Width="30" Margin="4,0,0,0" Click="ClearMedia_Click" />
                            <Button DockPanel.Dock="Right" Content="{loc:T Btn_Browse}" Padding="10,3" Margin="4,0,0,0" Click="BrowseMedia_Click" />
                            <TextBox x:Name="MediaBox" IsReadOnly="True" Padding="4" />
                        </DockPanel>
                    </StackPanel>
                </Grid>

                <TextBlock Text="{loc:T Lbl_Explanation}" Margin="0,10,0,0" />
                <TextBox x:Name="ExplanationBox" Padding="4" Margin="0,2,0,0" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="44" />

                <TextBlock x:Name="AnswersHeader" Margin="0,12,0,4" TextWrapping="Wrap" FontWeight="SemiBold" />
                <StackPanel x:Name="AnswersPanel" />

                <WrapPanel Margin="0,12,0,0">
                    <Button Content="{loc:T Btn_AddNew}" Padding="12,5" Margin="0,0,6,6" Click="AddQuestion_Click" />
                    <Button Content="{loc:T Btn_UpdateSelected}" Padding="12,5" Margin="0,0,6,6" Click="UpdateQuestion_Click" />
                    <Button Content="{loc:T Btn_RemoveSelected}" Padding="12,5" Margin="0,0,6,6" Click="RemoveQuestion_Click" />
                    <Button Content="{loc:T Btn_ClearForm}" Padding="12,5" Margin="0,0,6,6" Click="ClearForm_Click" />
                </WrapPanel>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Grid.ColumnSpan="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{loc:T Btn_SaveTest}" Padding="18,7" Margin="0,0,8,0" FontWeight="Bold" Click="Save_Click" />
            <Button Content="{loc:T Btn_Cancel}" Padding="18,7" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
