<UserControl x:Class="TestingSystem.Views.AvailableTestsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:TestingSystem.Infrastructure">
    <DockPanel Margin="20">
        <TextBlock DockPanel.Dock="Top" Text="{loc:T Tab_Available}" FontSize="20" FontWeight="Bold" Margin="0,0,0,12" />
        <TextBlock x:Name="EmptyText" DockPanel.Dock="Top" Text="{loc:T Msg_NoTests}" Visibility="Collapsed"
                   Foreground="{DynamicResource SecondaryTextBrush}" />

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="Cards">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardStyle}" Width="310" Margin="0,0,16,16">
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Category}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" />
                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,8,0,8" MinHeight="36" />
                                <TextBlock Text="{Binding TimeLine}" FontSize="12" />
                                <TextBlock Text="{Binding RulesLine}" FontSize="12" />
                                <TextBlock Text="{Binding AttemptsLine}" FontSize="12" />
                                <TextBlock Text="{Binding LockLine}" FontSize="12" Foreground="{DynamicResource WarningBrush}" />
                                <Button Content="{loc:T Btn_Start}" IsEnabled="{Binding CanStart}" Padding="16,6"
                                        HorizontalAlignment="Left" Margin="0,12,0,0" Click="Start_Click" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
