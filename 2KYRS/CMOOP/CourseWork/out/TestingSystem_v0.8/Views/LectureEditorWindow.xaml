<Window x:Class="TestingSystem.Views.LectureEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:TestingSystem.Infrastructure"
        Width="1240" Height="820" MinWidth="980" MinHeight="620" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Параметри лекції -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="{loc:T Lect_FieldTitle}" />
                <TextBox Text="{Binding LectureTitle, UpdateSourceTrigger=PropertyChanged}" Padding="4" Margin="0,2,0,8" />

                <TextBlock Text="{loc:T Lect_FieldSummary}" />
                <TextBox Text="{Binding Summary, UpdateSourceTrigger=PropertyChanged}" Padding="4" Margin="0,2,0,8"
                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56" />

                <TextBlock Text="{loc:T Lbl_Category}" />
                <ComboBox ItemsSource="{Binding Categories}" DisplayMemberPath="Name" IsEditable="True"
                          Text="{Binding CategoryText, UpdateSourceTrigger=LostFocus}" Padding="4" Margin="0,2,0,8" />

                <CheckBox Content="{loc:T Lect_PublishCheck}" IsChecked="{Binding IsPublished}" Margin="0,4,0,10" />

                <TextBlock Text="{loc:T Lbl_AssignedGroups}" />
                <ItemsControl ItemsSource="{Binding Groups}" Margin="0,4,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" Margin="0,2" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{loc:T Hint_Groups}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" />

                <TextBlock Text="{loc:T Lect_RelatedTestLabel}" Margin="0,12,0,0" />
                <ComboBox ItemsSource="{Binding RelatedTests}" SelectedItem="{Binding SelectedRelatedTest}"
                          DisplayMemberPath="Title" Padding="4" Margin="0,2,0,12" />

                <!-- AI -->
                <Button Content="{loc:T Lect_AiGenerate}" Command="{Binding GenerateCommand}" Padding="12,6" HorizontalAlignment="Left" />
                <TextBlock Text="{loc:T Lect_AiHint}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                           Foreground="{DynamicResource SecondaryTextBrush}" />
                <ProgressBar IsIndeterminate="True" Height="6" Margin="0,8,0,0"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                <Button Content="{loc:T Btn_Cancel}" Command="{Binding CancelOperationCommand}" Padding="10,3" Margin="0,6,0,0"
                        HorizontalAlignment="Left" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{DynamicResource SuccessBrush}" />
                <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{DynamicResource ErrorBrush}" />
            </StackPanel>
        </ScrollViewer>

        <!-- Текст (Markdown) і попередній перегляд -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="{loc:T Lect_Markdown}" FontWeight="SemiBold" />
            <TextBox Grid.Row="1" Text="{Binding Content, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10"
                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="6"
                     FontFamily="Consolas" FontSize="13" />

            <TextBlock Grid.Row="2" Text="{loc:T Lect_Preview}" FontWeight="SemiBold" />
            <Border Grid.Row="3" Margin="0,4,0,0" BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}"
                    Background="{DynamicResource CardBackgroundBrush}">
                <FlowDocumentScrollViewer loc:MarkdownBehavior.Markdown="{Binding Content}"
                                          IsToolBarVisible="False" VerticalScrollBarVisibility="Auto" Background="Transparent" />
            </Border>
        </Grid>

        <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{loc:T Btn_SaveLecture}" Command="{Binding SaveCommand}" Padding="18,7" Margin="0,0,8,0" FontWeight="Bold" />
            <Button Content="{loc:T Btn_Cancel}" Command="{Binding CloseCommand}" Padding="18,7" />
        </StackPanel>
    </Grid>
</Window>
