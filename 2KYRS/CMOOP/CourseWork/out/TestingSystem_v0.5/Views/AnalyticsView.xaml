<UserControl x:Class="TestingSystem.Views.AnalyticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:TestingSystem.Infrastructure">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- фильтры и экспорт -->
        <WrapPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="{loc:T Lbl_Group}" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox x:Name="GroupCombo" Width="160" DisplayMemberPath="Name" Margin="0,0,16,0" SelectionChanged="Filter_Changed" />
            <TextBlock Text="{loc:T Lbl_Test}" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox x:Name="TestCombo" Width="260" DisplayMemberPath="Title" Margin="0,0,24,0" SelectionChanged="Filter_Changed" />
            <Button Content="{loc:T Btn_ExportExcel}" Padding="12,5" Margin="0,0,8,0" Click="ExportExcel_Click" />
            <Button Content="{loc:T Btn_ExportCsv}" Padding="12,5" Margin="0,0,8,0" Click="ExportCsv_Click" />
            <Button Content="{loc:T Btn_Report}" Padding="12,5" Click="Report_Click" />
        </WrapPanel>

        <DataGrid x:Name="ResultsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                  CanUserAddRows="False" SelectionMode="Single" MouseDoubleClick="ResultsGrid_DoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{loc:T Col_Student}" Binding="{Binding Student}" Width="*" />
                <DataGridTextColumn Header="{loc:T Col_Group}" Binding="{Binding Group}" Width="100" />
                <DataGridTextColumn Header="{loc:T Col_Test}" Binding="{Binding Test}" Width="*" />
                <DataGridTextColumn Header="{loc:T Col_Points}" Binding="{Binding Points}" Width="80" />
                <DataGridTextColumn Header="%" Binding="{Binding Percent, StringFormat=0.#}" Width="60" />
                <DataGridTextColumn Header="{loc:T Col_Passed}" Binding="{Binding PassedText}" Width="70" />
                <DataGridTextColumn Header="{loc:T Col_Status}" Binding="{Binding StatusText}" Width="150" />
                <DataGridTextColumn Header="{loc:T Col_Date}" Binding="{Binding Date, StringFormat=dd.MM.yyyy HH:mm}" Width="130" />
                <DataGridTextColumn Header="{loc:T Col_Violations}" Binding="{Binding Violations}" Width="90" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- сложные вопросы -->
        <StackPanel Grid.Row="2" Margin="0,14,0,6">
            <TextBlock Text="{loc:T Hdr_HardQuestions}" FontSize="16" FontWeight="Bold" />
            <TextBlock Text="{loc:T Hint_HardQuestions}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
        </StackPanel>

        <DataGrid x:Name="HardGrid" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                  CanUserAddRows="False">
            <!-- Вопросы, на которые чаще всего отвечают неверно (IsHard), подсвечиваются -->
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsHard}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource HardRowBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="{loc:T Col_Question}" Binding="{Binding QuestionText}" Width="*" />
                <DataGridTextColumn Header="{loc:T Col_Test}" Binding="{Binding TestTitle}" Width="220" />
                <DataGridTextColumn Header="{loc:T Col_Attempts}" Binding="{Binding Attempts}" Width="90" />
                <DataGridTextColumn Header="{loc:T Col_WrongRate}" Binding="{Binding WrongRatePercent, StringFormat=0.#}" Width="110" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
