<Window x:Class="TestingSystem.Views.SessionLockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:TestingSystem.Infrastructure"
        Title="{loc:T App_Title}" WindowStyle="None" WindowState="Maximized" ResizeMode="NoResize"
        Topmost="True" ShowInTaskbar="False"
        Background="{DynamicResource CardBackgroundBrush}">
    <!-- Окно на весь экран и непрозрачное: данные под ним не видны. Вся логика — в SessionLockViewModel. -->
    <Border Style="{StaticResource CardStyle}" Width="430" Padding="28" Margin="0"
            HorizontalAlignment="Center" VerticalAlignment="Center"
            Background="{DynamicResource HeaderBackgroundBrush}">
        <StackPanel>
            <TextBlock Text="🔒" FontSize="44" HorizontalAlignment="Center" />
            <TextBlock Text="{loc:T Lock_Title}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,6,0,0" />
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0"
                       Foreground="{DynamicResource SecondaryTextBrush}" />
            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,10" />

            <TextBlock Text="{loc:T Field_Password}" />
            <PasswordBox x:Name="PasswordInput" Padding="4" Margin="0,2,0,6"
                         loc:PasswordBoxAssistant.BoundPassword="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" MinHeight="20"
                       Foreground="{DynamicResource ErrorBrush}" />

            <Button Content="{loc:T Lock_Unlock}" Command="{Binding UnlockCommand}" IsDefault="True"
                    Padding="10,6" MinWidth="180" HorizontalAlignment="Center" Margin="0,8,0,0" />
            <Button Content="{loc:T Lock_Logout}" Command="{Binding LogoutCommand}"
                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                    HorizontalAlignment="Center" Margin="0,10,0,0" />
        </StackPanel>
    </Border>
</Window>
