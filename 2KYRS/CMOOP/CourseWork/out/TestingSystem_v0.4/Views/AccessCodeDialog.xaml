<Window x:Class="TestingSystem.Views.AccessCodeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:TestingSystem.Infrastructure"
        Title="{loc:T Dlg_AccessCode}" Width="340" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="20">
        <TextBlock Text="{loc:T Dlg_EnterCode}" TextWrapping="Wrap" />
        <PasswordBox x:Name="CodeBox" Padding="4" Margin="0,8,0,16" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="OK" IsDefault="True" Width="80" Padding="0,5" Margin="0,0,8,0" Click="Ok_Click" />
            <Button Content="{loc:T Btn_Cancel}" IsCancel="True" Width="90" Padding="0,5" />
        </StackPanel>
    </StackPanel>
</Window>
