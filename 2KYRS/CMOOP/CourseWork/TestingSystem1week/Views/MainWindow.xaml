<Window x:Class="TestingSystem.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TestingSystem — тиждень 1: моделі та сховище" Height="420" Width="640">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Тиждень 1: User / Group + in-memory репозиторії через DI (див. README)" TextWrapping="Wrap" Margin="0,0,0,12"/>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <GroupBox Header="Групи (IGroupRepository)" Margin="0,0,8,0">
                <ListBox x:Name="GroupsList" DisplayMemberPath="Name"/>
            </GroupBox>
            <GroupBox Header="Користувачі (IUserRepository)" Grid.Column="1" Margin="8,0,0,0">
                <ListBox x:Name="UsersList" DisplayMemberPath="Username"/>
            </GroupBox>
        </Grid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
            <TextBox x:Name="GroupNameBox" Width="220" Margin="0,0,8,0"/>
            <Button Content="Додати групу" Width="120" Click="OnAddGroup"/>
            <Button Content="Оновити" Width="100" Margin="8,0,0,0" Click="OnRefresh"/>
        </StackPanel>
    </Grid>
</Window>
