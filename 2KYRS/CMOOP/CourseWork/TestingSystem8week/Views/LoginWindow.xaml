<Window x:Class="TestingSystem.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вхід — тиждень 2" Height="300" Width="380">
    <StackPanel Margin="20">
        <TextBlock Text="Вхід (демо: teacher / student1 / admin, пароль 1234)" TextWrapping="Wrap" Margin="0,0,0,12"/>
        <TextBlock Text="Логін"/>
        <TextBox x:Name="LoginBox" Margin="0,0,0,8"/>
        <TextBlock Text="Пароль"/>
        <PasswordBox x:Name="PasswordBox" Margin="0,0,0,12"/>
        <TextBlock x:Name="ErrorText" Foreground="Red" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="Увійти" Width="110" Click="OnLogin"/>
            <Button Content="Реєстрація" Width="110" Margin="8,0,0,0" Click="OnRegister"/>
        </StackPanel>
    </StackPanel>
</Window>
