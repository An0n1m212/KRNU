<Window x:Class="TestingSystem.Views.GroupsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Групи — адміністратор (ТЗ п.3.9)" Height="400" Width="520">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
            <TextBox x:Name="NameBox" Width="220"/>
            <Button Content="Додати" Width="90" Margin="8,0,0,0" Click="OnAdd"/>
            <Button Content="Видалити" Width="90" Margin="8,0,0,0" Click="OnDelete"/>
        </StackPanel>
        <ListBox x:Name="GroupsList"/>
    </DockPanel>
</Window>
