<Window x:Class="TestingSystem.Views.AiSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI-налаштування — тиждень 8" Height="560" Width="560">
    <ScrollViewer><StackPanel Margin="20">
        <TextBlock Text="Провайдер (Mock — офлайн-демо; решта — через HTTPS, крім localhost)" TextWrapping="Wrap"/>
        <ComboBox x:Name="ProviderBox" Margin="0,4,0,8"/>
        <TextBlock Text="Base URL (порожньо для Mock)"/>
        <TextBox x:Name="UrlBox" Margin="0,4,0,8"/>
        <TextBlock Text="Модель"/>
        <TextBox x:Name="ModelBox" Margin="0,4,0,8"/>
        <TextBlock Text="API-ключ (зберігається зашифрованим DPAPI, лише поточний користувач Windows)"/>
        <PasswordBox x:Name="KeyBox" Margin="0,4,0,8"/>
        <TextBlock Text="Таймаут, с (5–300)"/>
        <TextBox x:Name="TimeoutBox" Margin="0,4,0,8"/>
        <StackPanel Orientation="Horizontal">
            <Button Content="Зберегти" Width="110" Click="OnSave"/>
            <Button Content="Перевірити з'єднання (очікується OK)" Width="260" Margin="8,0,0,0" Click="OnTest"/>
        </StackPanel>
        <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="0,10,0,10"/>
        <TextBlock Text="Як підключити: Mock працює без ключа. OpenAI-сумісні (OpenAI, OpenRouter, Ollama, LM Studio): вкажіть Base URL, модель і ключ. Деталі — docs/AI_PROVIDERS.md." TextWrapping="Wrap"/>
    </StackPanel></ScrollViewer>
</Window>
