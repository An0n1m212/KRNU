<Window x:Class="TestingSystem.Views.AiAssistantWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI-помічник — тиждень 8" Height="560" Width="780">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock x:Name="ProviderText" Margin="0,0,0,6"/>
            <WrapPanel>
                <StackPanel Width="300" Margin="0,0,12,0">
                    <TextBlock Text="Предмет / тема"/>
                    <TextBox x:Name="TopicBox" Margin="0,0,0,4"/>
                    <TextBlock Text="Кількість (тем/питань)"/>
                    <TextBox x:Name="CountBox" Text="5" Width="60" Margin="0,0,0,4"/>
                </StackPanel>
                <StackPanel Width="380">
                    <TextBlock Text="Дії (усе створене відкривається в редакторах як чернетка)" TextWrapping="Wrap"/>
                    <WrapPanel Margin="0,4,0,0">
                        <Button Content="Теми лекцій" Width="120" Click="OnTopics"/>
                        <Button Content="Лекція" Width="100" Margin="6,0,0,0" Click="OnLecture"/>
                        <Button Content="Тест" Width="100" Margin="6,0,0,0" Click="OnTest"/>
                        <Button Content="Скасувати" Width="100" Margin="6,0,0,0" Click="OnCancel"/>
                    </WrapPanel>
                    <ProgressBar x:Name="Progress" Height="12" Margin="0,8,0,0" IsIndeterminate="False"/>
                </StackPanel>
            </WrapPanel>
            <TextBlock Text="Приватність: зовнішньому провайдеру передаються лише тексти матеріалів і відповіді без імен (ТЗ п.3.7.4)." TextWrapping="Wrap" Margin="0,6,0,0"/>
        </StackPanel>
        <ListBox x:Name="OutputList" Grid.Row="1" Margin="0,8,0,8"/>
        <TextBlock x:Name="StatusText" Grid.Row="2" TextWrapping="Wrap"/>
    </Grid>
</Window>
