<Window x:Class="TestingSystem.Views.ResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Підсумок" Height="260" Width="420" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="20">
        <TextBlock x:Name="SummaryText" FontSize="16" TextWrapping="Wrap" Margin="0,0,0,12"/>
        <TextBlock x:Name="DetailsText" TextWrapping="Wrap"/>
        <Button Content="Закрити" Width="100" Margin="0,16,0,0" Click="OnClose"/>
    </StackPanel>
</Window>
