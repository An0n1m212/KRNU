<Window x:Class="TestingSystem.Views.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Реєстрація студента — тиждень 2" Height="440" Width="400">
    <StackPanel Margin="20">
        <TextBlock Text="Реєстрація доступна лише студентам (з вибором групи)" TextWrapping="Wrap" Margin="0,0,0,12"/>
        <TextBlock Text="Логін"/><TextBox x:Name="LoginBox" Margin="0,0,0,6"/>
        <TextBlock Text="ПІБ"/><TextBox x:Name="FullNameBox" Margin="0,0,0,6"/>
        <TextBlock Text="Email"/><TextBox x:Name="EmailBox" Margin="0,0,0,6"/>
        <TextBlock Text="Пароль (мін. 6 символів)"/><PasswordBox x:Name="PasswordBox" Margin="0,0,0,6"/>
        <TextBlock Text="Група"/><ComboBox x:Name="GroupBox" DisplayMemberPath="Name" Margin="0,0,0,10"/>
        <TextBlock x:Name="ErrorText" Foreground="Red" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="Зареєструвати" Width="130" Click="OnRegister"/>
            <Button Content="Назад" Width="90" Margin="8,0,0,0" Click="OnBack"/>
        </StackPanel>
    </StackPanel>
</Window>
