<Window x:Class="TestingSystem.Views.TeacherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Кабінет викладача — тиждень 3 (конструктор, ч.1)" Height="450" Width="700">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Тести (тиждень 3: один/кілька варіантів + текст)" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <Button Content="Новий тест" Width="110" Click="OnNew"/>
            <Button Content="Редагувати" Width="110" Margin="8,0,0,0" Click="OnEdit"/>
            <Button Content="Видалити" Width="100" Margin="8,0,0,0" Click="OnDelete"/>
            <Button Content="Вийти" Width="80" Margin="8,0,0,0" Click="OnLogout"/>
        </StackPanel>
        <ListBox x:Name="TestsList" DisplayMemberPath="Title"/>
    </DockPanel>
</Window>
