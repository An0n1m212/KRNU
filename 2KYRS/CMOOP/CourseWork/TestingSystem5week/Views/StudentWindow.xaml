<Window x:Class="TestingSystem.Views.StudentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Кабінет студента — тиждень 5 (проходження)" Height="520" Width="720">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock x:Name="UserText" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <Button Content="Почати" Width="90" Click="OnStart"/>
            <Button Content="Оновити" Width="90" Margin="8,0,0,0" Click="OnRefresh"/>
            <Button Content="Вийти" Width="80" Margin="8,0,0,0" Click="OnLogout"/>
        </StackPanel>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="3*"/>
                <RowDefinition Height="2*"/>
            </Grid.RowDefinitions>
            <GroupBox Header="Доступні тести (час • питання • прохідний • спроби • пін)">
                <ListBox x:Name="TestsList"/>
            </GroupBox>
            <GroupBox Header="Мої результати" Grid.Row="1" Margin="0,8,0,0">
                <ListBox x:Name="ResultsList"/>
            </GroupBox>
        </Grid>
    </DockPanel>
</Window>
