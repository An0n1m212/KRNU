<UserControl x:Class="TestingSystem.Views.AvatarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Ellipse x:Name="BackEllipse" />
        <Viewbox Margin="10">
            <TextBlock x:Name="InitialsText" FontSize="32" FontWeight="SemiBold" Foreground="White" />
        </Viewbox>
        <Ellipse x:Name="PhotoEllipse" />
    </Grid>
</UserControl>
