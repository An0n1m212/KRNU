<Window x:Class="Lab5.Tasks.Task1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lab5.Tasks"
        mc:Ignorable="d"
        Title="Task1" Height="auto" Width="auto">
    <Grid>
        <StackPanel Margin="20" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel.Background>
                <LinearGradientBrush EndPoint="0,1" StartPoint="1,0">
                    <GradientStop Color="#FF7D7D7D"/>
                    <GradientStop Color="White" Offset="1"/>
                </LinearGradientBrush>
            </StackPanel.Background>
            <TextBlock x:Name="StatusLabel" Text="Початок роботи" FontSize="18" HorizontalAlignment="Center" Margin="0,10,0,20"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Привіт" Width="110" Height="35" Margin="5" Click="GreetingButton_Click"/>
                <Button Content="До побачення" Width="110" Height="35" Margin="5" Click="GreetingButton_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
