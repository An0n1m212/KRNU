<Window x:Class="Lab5.Tasks.Task3"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lab5.Tasks"
        mc:Ignorable="d"
        Title="Task3" Height="auto" Width="auto">
    <Grid>
        <StackPanel Margin="20" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBox x:Name="InputTextBox" Text="Введіть текст..." Width="260" Height="30" Margin="0,0,0,15"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Приховати" Width="80" Height="30" Margin="5" Click="HideInput_Click"/>
                <Button Content="Показати" Width="80" Height="30" Margin="5" Click="ShowInput_Click"/>
                <Button Content="Очистити" Width="80" Height="30" Margin="5" Click="ClearInput_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
