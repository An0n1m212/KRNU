<Window x:Class="Lab5.Tasks.Task6"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lab5.Tasks"
        mc:Ignorable="d"
        Title="Task6" Height="auto" Width="auto">
    <Grid>
        <StackPanel Margin="20" Width="320" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock x:Name="RecipeText" Text="Рецепт: R=?, G=?, B=?" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>

            <Rectangle x:Name="CrystalRectangle" Height="100" RadiusX="8" RadiusY="8" Stroke="Gray" StrokeThickness="1" Margin="0,0,0,15"/>

            <TextBlock Text="Червоний (R):"/>
            <Slider x:Name="SliderR" Minimum="0" Maximum="255" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Slider_ValueChanged"/>

            <TextBlock Text="Зелений (G):" Margin="0,8,0,0"/>
            <Slider x:Name="SliderG" Minimum="0" Maximum="255" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Slider_ValueChanged"/>

            <TextBlock Text="Синій (B):" Margin="0,8,0,0"/>
            <Slider x:Name="SliderB" Minimum="0" Maximum="255" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Slider_ValueChanged"/>

            <Button Content="Згенерувати новий рецепт" Margin="0,15,0,0" Height="30" Click="NewRecipe_Click"/>
        </StackPanel>
    </Grid>
</Window>
