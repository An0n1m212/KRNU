<Window x:Class="Lab6.Calculator"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Калькулятор" Height="450" Width="320"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="25"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Історія операцій -->
        <TextBox x:Name="HistoryTextBox" Grid.Row="0" IsReadOnly="True" Focusable="False" 
                 HorizontalContentAlignment="Right" BorderThickness="0" Background="Transparent" Foreground="Gray"/>

        <!-- Поле поточного введення -->
        <TextBox x:Name="CurrentTextBox" Grid.Row="1" IsReadOnly="True" Focusable="False" 
                 HorizontalContentAlignment="Right" FontSize="28" FontWeight="Bold" Text="0" VerticalContentAlignment="Center"/>

        <!-- Панель кнопок -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Рядок 1 -->
            <Button Content="CE" Grid.Row="0" Grid.Column="0" Margin="2" FontSize="16" Click="CE_Click"/>
            <Button Content="C" Grid.Row="0" Grid.Column="1" Margin="2" FontSize="16" Click="C_Click"/>
            <Button Content="&lt;" Grid.Row="0" Grid.Column="2" Margin="2" FontSize="16" Click="Backspace_Click"/>
            <Button Content="/" Grid.Row="0" Grid.Column="3" Margin="2" FontSize="16" Click="Operation_Click"/>

            <!-- Рядок 2 -->
            <Button Content="7" Grid.Row="1" Grid.Column="0" Margin="2" FontSize="18" Click="Digit_Click"/>
            <Button Content="8" Grid.Row="1" Grid.Column="1" Margin="2" FontSize="18" Click="Digit_Click"/>
            <Button Content="9" Grid.Row="1" Grid.Column="2" Margin="2" FontSize="18" Click="Digit_Click"/>
            <Button Content="*" Grid.Row="1" Grid.Column="3" Margin="2" FontSize="16" Click="Operation_Click"/>

            <!-- Рядок 3 -->
            <Button Content="4" Grid.Row="2" Grid.Column="0" Margin="2" FontSize="18" Click="Digit_Click"/>
            <Button Content="5" Grid.Row="2" Grid.Column="1" Margin="2" FontSize="18" Click="Digit_Click"/>
            <Button Content="6" Grid.Row="2" Grid.Column="2" Margin="2" FontSize="18" Click="Digit_Click"/>
            <Button Content="-" Grid.Row="2" Grid.Column="3" Margin="2" FontSize="16" Click="Operation_Click"/>

            <!-- Рядок 4 -->
            <Button Content="1" Grid.Row="3" Grid.Column="0" Margin="2" FontSize="18" Click="Digit_Click"/>
            <Button Content="2" Grid.Row="3" Grid.Column="1" Margin="2" FontSize="18" Click="Digit_Click"/>
            <Button Content="3" Grid.Row="3" Grid.Column="2" Margin="2" FontSize="18" Click="Digit_Click"/>
            <Button Content="+" Grid.Row="3" Grid.Column="3" Margin="2" FontSize="16" Click="Operation_Click"/>

            <!-- Рядок 5 -->
            <Button Content="." Grid.Row="4" Grid.Column="0" Margin="2" FontSize="18" Click="Dot_Click"/>
            <Button Content="0" Grid.Row="4" Grid.Column="1" Margin="2" FontSize="18" Click="Digit_Click"/>
            <Button Content="=" Grid.Row="4" Grid.Column="2" Grid.ColumnSpan="2" Margin="2" FontSize="18" Click="Equals_Click"/>
        </Grid>
    </Grid>
</Window>