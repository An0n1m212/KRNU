<Window x:Class="Lab6.MainWindow"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Лабораторна робота №6" Height="320" Width="420"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Лабораторна робота № 6" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <Button Content="Завдання 1: Калькулятор" Height="40" FontSize="14" Click="OpenCalculator_Click" Margin="0,5"/>
            <Button Content="Завдання 2: Автозаправка BestOil" Height="40" FontSize="14" Click="OpenBestOil_Click" Margin="0,5"/>
            <Button Content="Завдання 3: Місто мрії (Клікер)" Height="40" FontSize="14" Click="OpenCity_Click" Margin="0,5"/>
        </StackPanel>
    </Grid>
</Window>