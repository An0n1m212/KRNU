<Window x:Class="Lab6.City"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Місто мрії" Height="450" Width="600"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Верхнє меню керування -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock x:Name="BalanceTextBlock" Text="Баланс: 0 $" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,15,0"/>
            <Button Content="Заробити 10 $" Width="110" Height="35" Click="Work_Click" Margin="0,0,15,0"/>

            <ComboBox x:Name="BuildingComboBox" Width="150" Height="35" VerticalContentAlignment="Center" Margin="0,0,10,0"/>
            <Button Content="Купити" Width="80" Height="35" Click="Buy_Click"/>
        </StackPanel>

        <!-- Ігрова карта міста -->
        <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="1" Background="#E8F5E9" CornerRadius="5">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <WrapPanel x:Name="CityPanel" Margin="10"/>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>