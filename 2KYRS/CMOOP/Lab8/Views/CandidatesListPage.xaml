<Page x:Class="Lab8.CandidatesListPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="CandidatesListPage">

    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Панель фільтрів -->
        <GroupBox Header="Фільтрація кандидатів" Grid.Column="0" Margin="0,0,10,0" Padding="10">
            <StackPanel>
                <TextBlock Text="Освіта:" FontWeight="Bold" Margin="0,5,0,2"/>
                <ComboBox x:Name="CmbFilterEducation" SelectionChanged="ApplyFilter">
                    <ComboBoxItem Content="Всі" IsSelected="True"/>
                    <ComboBoxItem Content="Середня"/>
                    <ComboBoxItem Content="Середня спеціальна"/>
                    <ComboBoxItem Content="Вища"/>
                </ComboBox>

                <TextBlock Text="Мінімальний стаж (років):" FontWeight="Bold" Margin="0,10,0,2"/>
                <TextBox x:Name="TxtFilterExp" TextChanged="ApplyFilter"/>

                <CheckBox x:Name="ChkFilterComputer" Content="Тільки ті, хто володіє ПК" Margin="0,15,0,0" Checked="ApplyFilter" Unchecked="ApplyFilter"/>
                <CheckBox x:Name="ChkFilterRec" Content="Тільки з рекомендаціями" Margin="0,10,0,0" Checked="ApplyFilter" Unchecked="ApplyFilter"/>

                <Button Content="Скинути фільтри" Margin="0,20,0,0" Height="30" Click="BtnResetFilter_Click"/>
            </StackPanel>
        </GroupBox>

        <!-- Список кандидатів -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ListBox x:Name="LstCandidates" Margin="0,0,0,10" HorizontalContentAlignment="Stretch">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding FullName}" FontSize="16" FontWeight="Bold" Foreground="#2C3E50"/>
                                    <TextBlock Text="{Binding BirthDate, StringFormat='Дата народження: {0:dd.MM.yyyy}'}" Foreground="#7F8C8D"/>
                                    <TextBlock Text="{Binding Education, StringFormat='Освіта: {0}'}"/>
                                    <TextBlock Text="{Binding LanguageSkills, StringFormat='Іноземні мови: {0}'}"/>
                                    <TextBlock Text="{Binding ExperienceYears, StringFormat='Стаж роботи: {0} років'}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                        <TextBlock Text="ПК: Так" Margin="0,0,15,0" Foreground="Green">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding KnowsComputer}" Value="False">
                                                            <Setter Property="Text" Value="ПК: Ні"/>
                                                            <Setter Property="Foreground" Value="Red"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="Рекомендації: Є" Foreground="Green">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasRecommendations}" Value="False">
                                                            <Setter Property="Text" Value="Рекомендації: Немає"/>
                                                            <Setter Property="Foreground" Value="Red"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <Button Content="Редагувати" Width="110" Height="30" Margin="0,0,0,5" Click="BtnEdit_Click"/>
                                    <Button Content="Видалити" Width="110" Height="30" Click="BtnDelete_Click" Background="#E74C3C" Foreground="White"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</Page>
