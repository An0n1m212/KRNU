<Window x:Class="Lab8.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Конкурс на заміщення вакантної посади" Height="650" Width="950" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="#2C3E50" Padding="10">
            <StackPanel Orientation="Horizontal">
                <Button Content="Список кандидатів" Width="180" Height="35" Margin="5" Click="BtnListPage_Click" Background="#34495E" Foreground="White" FontWeight="Bold"/>
                <Button Content="Додати кандидата" Width="180" Height="35" Margin="5" Click="BtnAddPage_Click" Background="#34495E" Foreground="White" FontWeight="Bold"/>
            </StackPanel>
        </Border>

        <Frame x:Name="MainFrame" Grid.Row="1" NavigationUIVisibility="Hidden"/>
    </Grid>
</Window>
