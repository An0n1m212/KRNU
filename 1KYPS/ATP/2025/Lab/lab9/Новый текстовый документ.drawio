        </mxCell>
        <mxCell id="assign_vals" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="Assign specific files:&#xa;files[0]..files[5] (via constr)&#xa;files[6]..files[9] (via assignment)" vertex="1">
          <mxGeometry height="60" width="200" x="280" y="320" as="geometry" />
        </mxCell>
        <mxCell id="out_count" parent="1" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;" value="Output: Total objects created" vertex="1">
          <mxGeometry height="50" width="200" x="280" y="420" as="geometry" />
        </mxCell>
        <mxCell id="call_input_start" parent="1" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;" value="start_time = getInputTime(&quot;Start date&quot;)" vertex="1">
          <mxGeometry height="50" width="220" x="270" y="510" as="geometry" />
        </mxCell>
        <mxCell id="call_input_end" parent="1" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;" value="end_time = getInputTime(&quot;End date&quot;)" vertex="1">
          <mxGeometry height="50" width="220" x="270" y="600" as="geometry" />
        </mxCell>
        <mxCell id="call_query" parent="1" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;" value="queryFiles(files, 10, start, end)&#xa;[Filter by date &amp; Sort by size]" vertex="1">
          <mxGeometry height="60" width="220" x="270" y="690" as="geometry" />
        </mxCell>
        <mxCell id="out_end" parent="1" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;" value="Output: End execution&#xa;Output: Remaining objects count" vertex="1">
          <mxGeometry height="60" width="220" x="270" y="790" as="geometry" />
        </mxCell>
        <mxCell id="end" parent="1" style="ellipse;whiteSpace=wrap;html=1;" value="End Main" vertex="1">
          <mxGeometry height="60" width="120" x="320" y="900" as="geometry" />
        </mxCell>
        <mxCell id="edge1" edge="1" parent="1" source="start" target="init_locale">
