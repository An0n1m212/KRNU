        <mxCell id="start" parent="1" style="ellipse;whiteSpace=wrap;html=1;" value="Start Main" vertex="1">
          <mxGeometry height="60" width="120" x="320" y="40" as="geometry" />
        </mxCell>
        <mxCell id="init_locale" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="setlocale(LC_ALL, ...)" vertex="1">
          <mxGeometry height="40" width="160" x="300" y="140" as="geometry" />
        </mxCell>
        <mxCell id="create_objs" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="Create Array files[10]&#xa;Initialize 10 FILE_C objects" vertex="1">
